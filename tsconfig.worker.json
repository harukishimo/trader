{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "incremental": false,
    "isolatedModules": false,
    "plugins": []
  },
  "include": ["scripts/worker.ts", "src/core/**/*.ts"],
  "exclude": ["node_modules", "src/core/**/*.test.ts"]
}
